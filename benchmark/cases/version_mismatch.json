{
  "category": "version-mismatch",
  "about": "Package findings whose answer depends on reading versions the way the package system does. A naive string or numeric compare gets several of these wrong.",
  "cases": [
    {"id": "vm-deb-below-fix", "truth": "real", "expect": "confirmed_applicable",
     "why": "Debian security revision deb11u3 is older than the fix deb11u4.",
     "findings": [{"shape": "package", "purl": "pkg:deb/debian/openssl@1.1.1n-0+deb11u3", "installed": "1.1.1n-0+deb11u3", "fixed": ["1.1.1n-0+deb11u4"], "cve": ["CVE-2023-0001"]}]},
    {"id": "vm-deb-epoch", "truth": "false_positive", "expect": "confirmed_not_applicable",
     "why": "Epoch 1 outranks any version without one: 1:2.0-1 is newer than 1.9-1.",
     "findings": [{"shape": "package", "purl": "pkg:deb/debian/libfoo@1:2.0-1", "installed": "1:2.0-1", "fixed": ["1.9-1"], "cve": ["CVE-2023-0002"]}]},
    {"id": "vm-deb-tilde", "truth": "real", "expect": "confirmed_applicable",
     "why": "A tilde sorts before the release: 1.0~rc1-1 is older than 1.0-1.",
     "findings": [{"shape": "package", "purl": "pkg:deb/debian/libbar@1.0~rc1-1", "installed": "1.0~rc1-1", "fixed": ["1.0-1"], "cve": ["CVE-2023-0003"]}]},
    {"id": "vm-ubuntu-numeric-segment", "truth": "false_positive", "expect": "confirmed_not_applicable",
     "why": "3ubuntu0.10 is newer than 3ubuntu0.6; a string compare says the opposite.",
     "findings": [{"shape": "package", "purl": "pkg:deb/ubuntu/openssh-server@1:8.9p1-3ubuntu0.10", "installed": "1:8.9p1-3ubuntu0.10", "fixed": ["1:8.9p1-3ubuntu0.6"], "cve": ["CVE-2023-0004"]}]},
    {"id": "vm-rpm-below-fix", "truth": "real", "expect": "confirmed_applicable",
     "why": "Release 19.el7 is older than 21.el7.",
     "findings": [{"shape": "package", "purl": "pkg:rpm/redhat/openssl@1.0.2k-19.el7", "installed": "1.0.2k-19.el7", "fixed": ["1.0.2k-21.el7"], "cve": ["CVE-2023-0005"]}]},
    {"id": "vm-rpm-release-numeric", "truth": "false_positive", "expect": "confirmed_not_applicable",
     "why": "Release 27 is newer than 6 (numeric segments, not strings).",
     "findings": [{"shape": "package", "purl": "pkg:rpm/redhat/openssl@3.0.7-27.el9", "installed": "3.0.7-27.el9", "fixed": ["3.0.7-6.el9"], "cve": ["CVE-2023-0006"]}]},
    {"id": "vm-rpm-tilde", "truth": "real", "expect": "confirmed_applicable",
     "why": "rpm tilde: 2.0~beta1 is a pre-release of 2.0.",
     "findings": [{"shape": "package", "purl": "pkg:rpm/fedora/libbaz@2.0~beta1-1", "installed": "2.0~beta1-1", "fixed": ["2.0-1"], "cve": ["CVE-2023-0007"]}]},
    {"id": "vm-apk-revision", "truth": "real", "expect": "confirmed_applicable",
     "why": "Alpine package revision r5 is older than r6.",
     "findings": [{"shape": "package", "purl": "pkg:apk/alpine/musl@1.2.4-r5", "installed": "1.2.4-r5", "fixed": ["1.2.4-r6"], "cve": ["CVE-2023-0008"]}]},
    {"id": "vm-apk-patch-suffix", "truth": "false_positive", "expect": "confirmed_not_applicable",
     "why": "apk _p (patch) sorts after the plain release.",
     "findings": [{"shape": "package", "purl": "pkg:apk/alpine/busybox@1.36.1_p1-r0", "installed": "1.36.1_p1-r0", "fixed": ["1.36.1-r0"], "cve": ["CVE-2023-0009"]}]},
    {"id": "vm-pypi-prerelease", "truth": "real", "expect": "confirmed_applicable",
     "why": "PEP 440: 2.0.0rc1 is before 2.0.0.",
     "findings": [{"shape": "package", "purl": "pkg:pypi/requests@2.0.0rc1", "installed": "2.0.0rc1", "fixed": ["2.0.0"], "cve": ["CVE-2023-0010"]}]},
    {"id": "vm-pypi-equal-to-fix", "truth": "false_positive", "expect": "confirmed_not_applicable",
     "why": "Installed is exactly the fixed version.",
     "findings": [{"shape": "package", "purl": "pkg:pypi/requests@2.31.0", "installed": "2.31.0", "fixed": ["2.31.0"], "cve": ["CVE-2023-0011"]}]},
    {"id": "vm-vendor-not-affected", "truth": "false_positive", "expect": "confirmed_not_applicable",
     "why": "The distro states this version is not affected.",
     "findings": [{"shape": "package", "purl": "pkg:deb/debian/zlib1g@1:1.2.13.dfsg-1", "installed": "1:1.2.13.dfsg-1", "fix_status": "not_affected", "cve": ["CVE-2023-0012"]}]},
    {"id": "vm-vendor-affected-no-fix", "truth": "real", "expect": "confirmed_applicable",
     "why": "The distro lists the version as affected and will not fix it.",
     "findings": [{"shape": "package", "purl": "pkg:deb/debian/binutils@2.40-2", "installed": "2.40-2", "fix_status": "will_not_fix", "cve": ["CVE-2023-0013"]}]},
    {"id": "vm-two-branches-between", "truth": "false_positive", "expect": "needs_review",
     "why": "Fixed in 2.4.1 (2.x branch) and 3.0.2 (3.x). Installed 2.9.0 is on the fixed 2.x branch, but the version string doesn't say which branch applies. Known limitation: review, not a guess.",
     "findings": [{"shape": "package", "purl": "pkg:pypi/libbranch@2.9.0", "installed": "2.9.0", "fixed": ["2.4.1", "3.0.2"], "cve": ["CVE-2023-0014"]}]},
    {"id": "vm-npm-no-comparator", "truth": "real", "expect": "needs_review",
     "why": "npm has no comparator yet (backlog B-024): review instead of a guess.",
     "findings": [{"shape": "package", "purl": "pkg:npm/lodash@4.17.20", "installed": "4.17.20", "fixed": ["4.17.21"], "cve": ["CVE-2021-23337"]}]}
  ]
}
