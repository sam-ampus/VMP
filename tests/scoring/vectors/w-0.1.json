{
  "weights_version": "w-0.1",
  "about": "Hand-computed scoring vectors. score = clamp(0..100, round_half_up(sum of factor contributions)). The base factor (cvss_base or severity_fallback) is always listed; other factors only when they contribute non-zero points. Each case's input is merged over 'defaults'.",
  "defaults": {
    "cvss_base": null,
    "source_severity": "high",
    "has_cve": true,
    "kev": false,
    "epss": null,
    "exploit_available": null,
    "internet_facing": null,
    "asset_criticality": null,
    "environment": null,
    "confidence": "unvalidated",
    "evidence_completeness": "full"
  },
  "cases": [
    {
      "id": "base_cvss_9_8",
      "why": "CVSS alone tops out at high: critical needs threat or exposure evidence on top.",
      "input": { "cvss_base": "9.8", "source_severity": "critical" },
      "expected": { "score": 59, "severity": "high", "band": "elevated",
        "factors": { "cvss_base": "58.8" },
        "missing_inputs": ["asset_criticality", "environment", "epss", "internet_facing"] }
    },
    {
